// emredurmusoglu.com Cloudflare Worker ayarı (taşıma 2).
// Worker'ı OpenNext üretiyor: `opennextjs-cloudflare build` next build
// çıktısını .open-next/worker.js'e çeviriyor. cloudflare/worker.ts onun
// önünde ince bir katman: HSTS ve tarayıcıya giden Cache-Control.
// Gizli değerler burada DEĞİL: canlıda `wrangler secret`, yerelde .env.local.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emredurmusoglu",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: node:crypto (panel parolası scrypt), Buffer, process.env.
  // global_fetch_strictly_public: OpenNext'in önerdiği; Worker'dan yapılan
  // fetch'ler kendi alan adına dönüp döngüye girmesin.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // OpenNext'in kendine istek atması için (önbellek yenileme). Ad Worker
  // adıyla aynı olmalı.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "emredurmusoglu" }],
  // Sayfa önbelleği (Vercel'deki ISR'ın karşılığı), bkz. open-next.config.ts.
  // Kova ve veritabanı Doğu Avrupa'da (eeur), ziyaretçilerin çoğuna yakın.
  // Yerel önizlemede wrangler ikisinin de taklidini .wrangler/ altında tutar.
  //
  // R2: üretilmiş sayfalar.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "emredurmusoglu-opennext-cache" }
  ],
  // D1: "bu sayfa eskidi" kayıtları. Panelden yayınlayınca revalidatePath
  // buraya yazar, sayfa bir sonraki istekte yeniden üretilir. revalidations
  // tablosunu OpenNext yüklemede kendisi kurar.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "emredurmusoglu-tag-cache",
      "database_id": "9e48d6b3-4f1a-45e8-b7ab-d22dec4e58b5"
    }
  ],
  // Durable Object kuyruğu: süresi dolan sayfayı (1 saat) arka planda yeniden
  // üretir; aynı sayfa için aynı anda tek üretim.
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  // next/image küçültmesi Cloudflare Images ile.
  "images": { "binding": "IMAGES" },
  // Canlı (taşıma 8): www.emredurmusoglu.com asıl adres; emredurmusoglu.com
  // Cloudflare Redirect Rule ile www'ye gider (Worker'dan önce çalışır).
  //
  // www ve kök "custom domain" değil, Workers Route: wrangler var olan DNS
  // kaydını (Vercel'i gösteren) silmeden custom domain eklemiyordu, silmek de
  // kesinti demekti. Route'ta kayıt yerinde kalıyor; DNS'te turuncu bulut
  // (proxy) açılınca istekler Cloudflare'e gelir ve Worker karşılar, Vercel'e
  // hiç gitmez. Geri dönüş: bulutu kapatmak.
  //
  // Deneme adresi arama motorlarına kapalı (cloudflare/worker.ts), 10. adımda
  // kalkacak.
  "routes": [
    { "pattern": "www.emredurmusoglu.com/*", "zone_name": "emredurmusoglu.com" },
    { "pattern": "emredurmusoglu.com/*", "zone_name": "emredurmusoglu.com" },
    { "pattern": "deneme.emredurmusoglu.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
