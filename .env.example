# Neon Postgres connection string (Vercel > Storage > Neon üzerinden alınır)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Session cookie imza anahtarı — en az 32 karakter.
# Üret: openssl rand -base64 48
SESSION_SECRET=""

# Panel parolasının scrypt hash'i. Aynı parola /etsy'de "emre" kullanıcısı için de geçerli.
# Üret: npm run panel:hash -- 'senin-parolan'
PANEL_PASSWORD_HASH=""

# /etsy defterine giren diğer kullanıcıların parola hash'leri (bkz. lib/auth/users.ts).
# Üret: npm run panel:hash -- 'parola'
ETSY_DRYAAKY_PASSWORD_HASH=""
ETSY_ISMAILCAN_PASSWORD_HASH=""
